<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ergofocus.smartwatch">

    <!-- Declaración explícita para dispositivos Wear OS -->
    <uses-feature android:name="android.hardware.type.watch" />
    
    <!-- Permisos para avisos hápticos silenciosos en muñeca -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ErgoFocus Watch"
        android:theme="@android:style/Theme.DeviceDefault">
        
        <!-- Thin Companion: depende de la app móvil de ErgoFocus -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Listener Service para Wearable Data Layer API (Google Play Services) -->
        <service
            android:name=".WearableDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/ergofocus"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="ErgoFocus Watch"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
